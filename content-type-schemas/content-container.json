{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schema-examples.com/dynamic-yield-affinity-integration/content-container",
  "title": "Dynamic Yield content container",
  "description": "An ordered set of candidate content items for a consuming personalization implementation.",
  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    }
  ],
  "type": "object",
  "properties": {
    "content": {
      "title": "Candidate content",
      "description": "Add the targeted content items that a runtime can evaluate for this placement.",
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "allOf": [
          {
            "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content-link"
          },
          {
            "properties": {
              "contentType": {
                "enum": [
                  "https://schema-examples.com/dynamic-yield-affinity-integration/example-banner"
                ]
              }
            }
          }
        ]
      }
    }
  },
  "required": ["content"],
  "propertyOrder": ["content"]
}
