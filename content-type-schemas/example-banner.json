{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schema-examples.com/dynamic-yield-affinity-integration/example-banner",
  "title": "Example targeted banner",
  "description": "A portable example content type with Dynamic Yield targeting metadata.",
  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    }
  ],
  "type": "object",
  "properties": {
    "headline": {
      "title": "Headline",
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "body": {
      "title": "Body",
      "type": "string",
      "maxLength": 500
    },
    "image": {
      "title": "Image",
      "allOf": [
        {
          "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/image-link"
        }
      ]
    },
    "imageAltText": {
      "title": "Image alternative text",
      "description": "Describe the image for people who cannot see it.",
      "type": "string",
      "maxLength": 200
    },
    "targeting": {
      "allOf": [
        {
          "$ref": "https://schema-examples.com/dynamic-yield-affinity-integration/targeting#/definitions/targeting"
        }
      ]
    }
  },
  "required": ["headline"],
  "propertyOrder": ["headline", "body", "image", "imageAltText", "targeting"]
}
