{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schema-examples.com/dynamic-yield-affinity-integration/affinity-group",
  "title": "Dynamic Yield affinity group",
  "description": "A hierarchy root that groups values for one Dynamic Yield affinity or targeting dimension.",
  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    }
  ],
  "trait:hierarchy": {
    "childContentTypes": [
      "https://schema-examples.com/dynamic-yield-affinity-integration/affinity-value"
    ]
  },
  "type": "object",
  "properties": {
    "label": {
      "title": "Label",
      "description": "An author-facing name for this targeting dimension.",
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  },
  "required": ["label"],
  "propertyOrder": ["label"]
}
